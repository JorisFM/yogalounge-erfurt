---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import matten from '../assets/img/raum-matten.jpg';
import still from '../assets/img/stillleben.jpg';
---

<Base
  title="Räume mieten"
  description="Yogaräume in der Erfurter Altstadt mieten: vier Räume von 30 bis 45 m² für Workshops, Seminare, Coachings und Fotoshootings. 35 bis 45 € pro Raum und Stunde."
>
  <PageHero
    label="Räume mieten"
    title="Platz für deinen Workshop"
    lead="Wir vermieten unsere Räume in der Altstadt für Kurse, Workshops, Seminare, Coachings, Fotoshootings und Videodrehs. Bis zu 40 Personen haben Platz."
  >
    <div class="btn-row">
      <a class="btn" href={`mailto:${site.email}?subject=Raumanfrage`}>
        Besichtigung anfragen <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </PageHero>

  <section class="section section--tight">
    <div class="wrap photo-row">
      <div class="media">
        <Image src={matten} alt="Yogaraum mit Fischgrätparkett und vorbereiteten Matten" widths={[640, 960, 1400]} sizes="(max-width: 700px) 100vw, 60vw" loading="eager" />
      </div>
      <div class="media">
        <Image src={still} alt="Decken, Sitzkissen und Buddhafigur im Studio" widths={[480, 800]} sizes="(max-width: 700px) 100vw, 40vw" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="cols">
        <div class="cols__head">
          <p class="label">Preis</p>
          <h2>35 bis 45 € pro Raum und Stunde</h2>
        </div>
        <div class="cols__body">
          <p>
            Der Preis hängt von der Raumgröße und der Mietdauer ab. Du kannst einzelne Räume oder mehrere zusammen mieten,
            einige lassen sich miteinander verbinden.
          </p>
        </div>
      </div>

      <div class="cols">
        <div class="cols__head">
          <p class="label">Räume</p>
          <h2>Was du mieten kannst</h2>
        </div>
        <div class="cols__body">
          <ul class="dots">
            <li>Vier helle Yogaräume mit Holzboden, 30 bis 45 m²</li>
            <li>Einen eingerichteten Coachingraum</li>
            <li>Einen Massageraum mit Massageliegen und Futonmatte</li>
          </ul>
          <h3>Inklusive</h3>
          <ul class="dots">
            <li>Yogamaterial: Matten, Blöcke, Gurte, Bolster, Decken</li>
            <li>Küche mit Loungebereich und Sitzpodest für Pausen und kleine Runden</li>
            <li>Umkleiden und Toiletten</li>
            <li>Auf Anfrage Flipchart, Whiteboard, Soundboxen, Beamer mit Leinwand und Bestuhlung</li>
          </ul>
        </div>
      </div>

      <div class="cols">
        <div class="cols__head">
          <p class="label">Für wen</p>
          <h2>Dein Thema, unser Raum</h2>
        </div>
        <div class="cols__body">
          <p>
            Du bist Coach, Yogalehrerin, Therapeut oder hast eine andere Leidenschaft, für die du einen schönen Ort suchst?
            Melde dich für Fragen oder eine Besichtigung: <a href={`mailto:${site.email}`}>{site.email}</a> oder{' '}
            <a href={site.phoneHref}>{site.phone}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
