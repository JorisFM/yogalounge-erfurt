---
import { wochenplan, tage, tageKurz } from '../data/kurse';
import { u } from '../lib/url';

interface Props {
  /** heute: ein Tag mit großen Uhrzeiten (Startseite). woche: alle Tage als Raster (Kursseite). */
  variant?: 'heute' | 'woche';
  headingLevel?: 'h2' | 'h3';
}

const { variant = 'woche', headingLevel = 'h3' } = Astro.props;
const woche = wochenplan();
const Heading = headingLevel;
---

<div class:list={['week', `week--${variant}`]} data-week>
  <div class="week__bar">
    {
      variant === 'heute' && (
        <p class="week__title display" aria-live="polite">
          <span class="week__title-pre" data-week-pre>
            Im Plan am
          </span>{' '}
          <span data-week-title>Montag</span>
        </p>
      )
    }
    <div class="week__tabs" role="group" aria-label="Wochentag wählen">
      {
        tageKurz.map((t, i) => (
          <button
            type="button"
            class="week__tab"
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-controls={`tag-${variant}-${i}`}
            data-week-tab={i}
          >
            <span aria-hidden="true">{t}</span>
            <span class="visually-hidden">{tage[i]}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="week__days">
    {
      woche.map((eintraege, i) => (
        <section
          class:list={['week__day', { 'is-active': i === 0 }]}
          id={`tag-${variant}-${i}`}
          data-week-day={i}
          aria-label={tage[i]}
        >
          <Heading class="week__dayname label">
            {tage[i]}
            <span class="week__today-badge" data-today-badge hidden>
              Heute
            </span>
          </Heading>
          <ol class="week__slots">
            {eintraege.map((e) => (
              <li class="slot" data-start={e.von} data-end={e.bis}>
                <a class="slot__link" href={u(`/kurse/${e.kurs.slug}/`)}>
                  <span class="slot__time num">
                    <time>{e.von}</time>
                    <span class="slot__end">
                      <span class="visually-hidden">bis</span>
                      <span aria-hidden="true">–</span>
                      {e.bis}
                    </span>
                  </span>
                  <span class="slot__body">
                    <span class="slot__name">{e.name}</span>
                    {e.zusatz && <span class="slot__meta">{e.zusatz}</span>}
                    <span class="slot__flag" data-flag hidden />
                  </span>
                </a>
              </li>
            ))}
          </ol>
          <p class="week__done" data-done hidden />
        </section>
      ))
    }
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.currentScript?.previousElementSibling;
    if (!root || !root.matches('[data-week]')) return;

    // Wochentag und Uhrzeit in Erfurt, unabhängig von der Zeitzone des Geräts.
    const parts = Object.fromEntries(
      new Intl.DateTimeFormat('de-DE', {
        timeZone: 'Europe/Berlin',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      })
        .formatToParts(new Date())
        .map((p) => [p.type, p.value]),
    );
    const order = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'];
    const today = order.indexOf(parts.weekday.replace('.', ''));
    const now = `${parts.hour}:${parts.minute}`;
    const names = ['Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag', 'Sonntag'];

    const tabs = root.querySelectorAll('[data-week-tab]');
    const days = root.querySelectorAll('[data-week-day]');
    const title = root.querySelector('[data-week-title]');
    const pre = root.querySelector('[data-week-pre]');

    const show = (i) => {
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(Number(t.dataset.weekTab) === i)));
      days.forEach((d) => d.classList.toggle('is-active', Number(d.dataset.weekDay) === i));
      if (title) title.textContent = i === today ? 'heute' : names[i];
      if (pre) pre.textContent = i === today ? 'Im Plan für' : 'Im Plan am';
    };

    if (today >= 0) {
      tabs[today]?.classList.add('is-today');
      const day = days[today];
      day.classList.add('is-today');
      day.querySelector('[data-today-badge]')?.removeAttribute('hidden');

      let flagged = false;
      day.querySelectorAll('.slot').forEach((slot) => {
        const { start, end } = slot.dataset;
        const flag = slot.querySelector('[data-flag]');
        if (end <= now) {
          slot.classList.add('is-past');
          flag.textContent = 'vorbei';
          flag.removeAttribute('hidden');
        } else if (!flagged) {
          flagged = true;
          slot.classList.add('is-next');
          flag.textContent = start <= now ? 'Läuft gerade' : 'Als Nächstes';
          flag.removeAttribute('hidden');
        }
      });

      if (!flagged) {
        // Heute ist alles vorbei: auf den nächsten Tag mit Klassen verweisen.
        for (let k = 1; k <= 7; k++) {
          const n = (today + k) % 7;
          const first = days[n].querySelector('.slot');
          if (first) {
            const done = day.querySelector('[data-done]');
            done.textContent = `Für heute sind alle Klassen vorbei. ${k === 1 ? 'Morgen' : names[n]} geht es um ${first.dataset.start} Uhr weiter.`;
            done.removeAttribute('hidden');
            break;
          }
        }
      }
      show(today);
    }

    tabs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.weekTab))));
  })();
</script>

<style>
  .week__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-block-end: 1.75rem;
  }
  .week__title {
    font-size: var(--step-3);
    line-height: 1;
  }
  .week__title-pre {
    display: block;
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--safran-tief);
    margin-block-end: 0.5rem;
  }
  .week__tabs {
    display: flex;
    gap: 0.35rem;
  }
  .week__tab {
    position: relative;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.5rem 0.2rem;
    border: 1.5px solid var(--linie);
    border-radius: 999px;
    background: var(--weiss);
    font-weight: 600;
    font-size: 0.98rem;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .week__tab:hover {
    border-color: var(--tinte);
  }
  .week__tab.is-today::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.55rem;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--safran);
  }
  .week__tab[aria-pressed='true'] {
    background: var(--tinte);
    border-color: var(--tinte);
    color: var(--kalk);
  }

  .week__slots {
    list-style: none;
    padding: 0;
  }
  .slot__link {
    display: flex;
    text-decoration: none;
    color: inherit;
  }
  .slot__time {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .slot__end {
    font-family: var(--font-text);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--tinte-3);
  }
  .slot__body {
    display: grid;
    gap: 0.15rem;
    align-content: start;
  }
  .slot__name {
    font-weight: 600;
    line-height: 1.25;
  }
  .slot__link:hover .slot__name {
    text-decoration: underline;
    text-decoration-color: var(--safran);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .slot__meta {
    font-size: 0.92rem;
    color: var(--tinte-2);
    line-height: 1.3;
  }
  .slot__flag {
    justify-self: start;
    margin-top: 0.4rem;
    padding: 0.15rem 0.6rem 0.05rem;
    border-radius: 999px;
    background: var(--safran);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .slot.is-past {
    opacity: 0.45;
  }
  .slot.is-past .slot__flag {
    background: var(--stuck);
  }
  .week__done {
    margin-top: 1rem;
    font-size: var(--step-1);
    color: var(--tinte-2);
  }

  :global(.js) .week__day:not(.is-active) {
    display: none;
  }
  .week__today-badge {
    margin-inline-start: 0.5rem;
    padding: 0.1rem 0.5rem 0;
    border-radius: 999px;
    background: var(--safran);
    color: var(--tinte);
  }

  /* ---- Variante „heute“: große Uhrzeiten nebeneinander ---- */
  .week--heute .week__dayname {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .week--heute .week__slots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
    gap: 0 1.5rem;
  }
  .week--heute .slot {
    border-top: 2px solid var(--tinte);
    padding-top: 1rem;
    padding-bottom: 1.5rem;
  }
  .week--heute .slot.is-next {
    border-top-color: var(--safran);
    border-top-width: 6px;
    padding-top: calc(1rem - 4px);
  }
  .week--heute .slot__link {
    flex-direction: column;
    gap: 0.9rem;
  }
  .week--heute .slot__time {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
  }
  .week--heute .slot__end {
    font-size: 1rem;
  }
  .week--heute .slot__name {
    font-size: var(--step-1);
  }
  @media (max-width: 560px) {
    .week--heute .week__slots {
      grid-template-columns: 1fr;
    }
    .week--heute .slot {
      padding-bottom: 1rem;
    }
    .week--heute .slot__link {
      flex-direction: row;
      gap: 1rem;
    }
    .week--heute .slot__time {
      flex-direction: column;
      gap: 0.3rem;
      min-width: 5.5rem;
      font-size: 2.4rem;
    }
  }

  /* ---- Variante „woche“: Raster mit sieben Spalten ---- */
  .week--woche .slot {
    border-top: 1px solid var(--linie);
  }
  .week--woche .slot__link {
    gap: 1rem;
    padding-block: 0.9rem;
  }
  .week--woche .slot__time {
    display: grid;
    gap: 0.25rem;
    min-width: 4.6rem;
    font-size: 1.75rem;
  }
  .week--woche .slot__end {
    font-size: 0.9rem;
  }
  .week--woche .week__dayname {
    display: flex;
    align-items: center;
    padding-block-end: 0.75rem;
    color: var(--tinte-2);
  }
  .week--woche .week__bar {
    justify-content: start;
  }

  @media (min-width: 1100px) {
    .week--woche .week__bar {
      display: none;
    }
    .week--woche .week__days {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 0;
      border-top: 2px solid var(--tinte);
    }
    :global(.js) .week--woche .week__day {
      display: block;
    }
    .week--woche .week__day {
      padding: 1rem 0.85rem 1.5rem;
      border-left: 1px solid var(--linie);
    }
    .week--woche .week__day:first-child {
      border-left: 0;
      padding-left: 0;
    }
    .week--woche .week__day.is-today {
      background: color-mix(in srgb, var(--safran) 14%, transparent);
      box-shadow: inset 0 4px 0 var(--safran);
    }
    .week--woche .week__day.is-today:first-child {
      padding-left: 0.85rem;
    }
    .week--woche .week__dayname {
      min-height: 2.1rem;
      flex-wrap: wrap;
      row-gap: 0.3rem;
    }
    .week--woche .week__today-badge {
      margin-inline-start: 0;
    }
    .week--woche .slot__link {
      flex-direction: column;
      gap: 0.5rem;
    }
    .week--woche .slot__time {
      display: flex;
      align-items: baseline;
      gap: 0.3rem;
      font-size: 1.55rem;
    }
    .week--woche .slot__name {
      font-size: 1.02rem;
      hyphens: auto;
    }
    .week--woche .slot__meta {
      font-size: 0.85rem;
    }
    .week--woche .week__done {
      font-size: 0.95rem;
    }
  }
</style>
