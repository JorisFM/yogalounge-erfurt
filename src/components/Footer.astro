---
import { site, bsport } from '../data/site';
import { u } from '../lib/url';

const spalten = [
  {
    titel: 'Yoga',
    links: [
      { href: u('/kurse/'), label: 'Kurse und Wochenplan' },
      { href: u('/preise/'), label: 'Preise und Karten' },
      { href: u('/erste-stunde/'), label: 'Deine erste Stunde' },
      { href: u('/kurse/krankenkassen-basiskurs/'), label: 'Yoga mit der Krankenkasse' },
      { href: u('/preise/#gutschein'), label: 'Gutschein verschenken' },
      { href: u('/retreat/'), label: 'Silvester-Retreat' },
    ],
  },
  {
    titel: 'YogaLounge',
    links: [
      { href: u('/studio/'), label: 'Das Studio' },
      { href: u('/team/'), label: 'Team' },
      { href: u('/raeume-mieten/'), label: 'Räume mieten' },
      { href: u('/unternehmen/'), label: 'Für Unternehmen' },
      { href: u('/zusammenarbeit/'), label: 'Jobs und Partner' },
      { href: u('/kontakt/'), label: 'Kontakt und Anfahrt' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__cta">
      <p class="site-footer__claim display">
        Deine erste Stunde<br />bei uns ist kostenlos.
      </p>
      <a class="btn btn--safran" href={bsport.kalender} target="_blank" rel="noopener">
        Probestunde buchen <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="site-footer__grid">
      <div class="site-footer__address">
        <p class="label">YogaLounge Erfurt</p>
        <address>
          {site.owner}<br />
          {site.street}<br />
          {site.zip} {site.city}
        </address>
        <p>
          <a href={site.phoneHref}>{site.phone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="site-footer__social">
          <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>
        </p>
      </div>
      {
        spalten.map((s) => (
          <nav aria-label={s.titel}>
            <p class="label">{s.titel}</p>
            <ul>
              {s.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="site-footer__legal">
      <p>© {new Date().getFullYear()} YogaLounge Erfurt · Kathrin Seemann</p>
      <ul>
        <li><a href={u('/impressum/')}>Impressum</a></li>
        <li><a href={u('/datenschutz/')}>Datenschutz</a></li>
        <li><a href={u('/agb/')}>AGB</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--tinte);
    color: color-mix(in srgb, var(--kalk) 82%, var(--tinte));
    padding-block: var(--space-l) 2rem;
    font-size: 1rem;
  }
  .site-footer a {
    color: var(--kalk);
    text-decoration-color: color-mix(in srgb, var(--kalk) 35%, transparent);
  }
  .site-footer a:not(.btn):hover {
    color: var(--safran);
  }
  .site-footer__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-block-end: var(--space-l);
    border-bottom: 1px solid color-mix(in srgb, var(--kalk) 16%, transparent);
  }
  .site-footer__claim {
    font-size: var(--step-4);
    color: var(--kalk);
    line-height: 1;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 2.5rem;
    padding-block: var(--space-l);
  }
  .site-footer .label {
    color: var(--safran);
    margin-block-end: 0.9rem;
  }
  .site-footer address {
    font-style: normal;
    margin-block-end: 0.9rem;
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
  }
  .site-footer li + li {
    margin-block-start: 0.35rem;
  }
  .site-footer nav a {
    text-decoration: none;
  }
  .site-footer__social {
    display: flex;
    gap: 1.25rem;
    margin-block-start: 0.9rem;
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block-start: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--kalk) 16%, transparent);
    font-size: 0.92rem;
  }
  .site-footer__legal ul {
    display: flex;
    gap: 1.5rem;
  }
  .site-footer__legal li + li {
    margin: 0;
  }
  @media (max-width: 760px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__address {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 420px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
