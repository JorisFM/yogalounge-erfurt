---
import type { Kurs } from '../data/kurse';
import { tageKurz, tage } from '../data/kurse';
import { u } from '../lib/url';

interface Props {
  kurs: Kurs;
}
const { kurs } = Astro.props;
const aktiv = new Set(kurs.termine.map((t) => t.tag));
const tageText = kurs.termine.length
  ? [...aktiv].sort().map((i) => tage[i]).join(', ')
  : 'Termine nach Plan';
---

<a class="card" href={u(`/kurse/${kurs.slug}/`)}>
  <h3 class="card__name">{kurs.name}</h3>
  <p class="card__text">{kurs.kurz}</p>
  <div class="card__foot">
    {
      kurs.termine.length > 0 ? (
        <p class="card__days" aria-label={`Wochentage: ${tageText}`}>
          {tageKurz.map((t, i) => (
            <span class:list={['card__day', { 'is-on': aktiv.has(i) }]} aria-hidden="true">
              {t}
            </span>
          ))}
        </p>
      ) : (
        <p class="card__days card__days--text">{kurs.slug === 'klangmassage' ? 'Einzeltermin' : 'Termine im Kursplan'}</p>
      )
    }
    <span class="card__dauer">{kurs.dauer}</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1.5rem 1.5rem 1.25rem;
    border: 1px solid var(--linie);
    border-radius: var(--radius-l);
    background: var(--weiss);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .card:hover {
    border-color: var(--tinte);
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -18px rgb(27 30 58 / 0.35);
  }
  .card__name {
    font-size: var(--step-2);
    hyphens: auto;
  }
  .card:hover .card__name {
    text-decoration: underline;
    text-decoration-color: var(--safran);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.18em;
  }
  .card__text {
    color: var(--tinte-2);
    line-height: 1.45;
  }
  .card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--linie);
    font-size: 0.9rem;
  }
  .card__days {
    display: flex;
    gap: 0.2rem;
  }
  .card__day {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding-top: 0.12rem;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--tinte-3);
    opacity: 0.55;
  }
  .card__day.is-on {
    background: var(--safran);
    color: var(--tinte);
    opacity: 1;
  }
  .card__days--text {
    font-weight: 600;
    color: var(--tinte-2);
  }
  .card__dauer {
    color: var(--tinte-3);
  }
</style>
